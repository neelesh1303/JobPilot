# Copy this file to data/.env (data/ is git-ignored) and fill in what you use.
# Locally these are read by the desktop app and scripts/discover.py.
# On GitHub Actions they are repository secrets; on Render they are environment variables.

# Daily job feed + inbox (shared database)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/jobpilot
GEMINI_API_KEY=
APIFY_TOKEN=
HUNTER_API_KEY=
# Optional: comma-separated Gemini models to try in order
# GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite

# Only for running the hosted inbox locally (python cloud_app.py)
APP_PASSCODE=
SECRET_KEY=

# Optional: credentials Claude uses to sign up on job portals (you can set these in the UI instead)
JOBPILOT_EMAIL=
JOBPILOT_PASSWORD=
